default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    team_id = "5RBBPXKGSL"
    auth_args = "-allowProvisioningUpdates -authenticationKeyPath '#{key_path}' -authenticationKeyID '#{key_id}' -authenticationKeyIssuerID '#{issuer_id}'"

    # CI環境用の一時キーチェーンを作成してアンロック
    keychain_name = "fastlane_keychain"
    keychain_password = "temporary_password_123"

    begin
      delete_keychain(name: keychain_name)
    rescue => e
      # 初回実行時などキーチェーンが存在しない場合は無視
    end

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # アプリのビルド・署名・IPAエクスポート (Xcodeの公式API自動プロビジョニングを利用)
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: team_id
      },
      xcargs: "DEVELOPMENT_TEAM=#{team_id} #{auth_args}",
      export_xcargs: auth_args,
      destination: "generic/platform=iOS"
    )

    # TestFlightへの自動送信
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end


