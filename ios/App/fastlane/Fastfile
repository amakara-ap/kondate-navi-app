default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    team_id = "5RBBPXKGSL"
    project_path = File.expand_path("../App.xcodeproj", __dir__)
    archive_path = File.expand_path("./build/App.xcarchive", __dir__)
    ipa_dir = File.expand_path("./build", __dir__)
    plist_path = File.expand_path("../ExportOptions.plist", __dir__)

    sh("mkdir -p '#{ipa_dir}'")

    UI.message("📦 Step 1: Archiving App...")
    sh("xcodebuild archive -project '#{project_path}' -scheme App -configuration Release -archivePath '#{archive_path}' -destination 'generic/platform=iOS' CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY='' DEVELOPMENT_TEAM=#{team_id}")

    UI.message("✍️ Step 2: Exporting IPA with Apple Code Signing...")
    sh("xcodebuild -exportArchive -archivePath '#{archive_path}' -exportPath '#{ipa_dir}' -exportOptionsPlist '#{plist_path}' -allowProvisioningUpdates -authenticationKeyPath '#{key_path}' -authenticationKeyID '#{key_id}' -authenticationKeyIssuerID '#{issuer_id}'")

    ipa_files = Dir.glob("#{ipa_dir}/*.ipa")
    if ipa_files.empty?
      UI.user_error!("❌ No .ipa file found in #{ipa_dir}")
    end
    ipa_path = ipa_files.first
    UI.message("🚀 Step 3: Uploading #{ipa_path} to TestFlight...")

    upload_to_testflight(
      ipa: ipa_path,
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
    UI.success("🎉 Successfully uploaded to TestFlight!")
  end
end
