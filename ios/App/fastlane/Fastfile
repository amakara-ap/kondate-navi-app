default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    team_id = "5RBBPXKGSL"
    auth_args = "-allowProvisioningUpdates -authenticationKeyPath '#{key_path}' -authenticationKeyID '#{key_id}' -authenticationKeyIssuerID '#{issuer_id}'"

    # App Store用プロビジョニングプロファイルを自動ダウンロード
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.shokuzai.kondatenavi"
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]

    # アプリのビルド設定 (アーカイブ時は高速生成、IPAエクスポート時にApp Store署名を実施)
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: team_id,
        provisioningProfiles: {
          "com.shokuzai.kondatenavi" => profile_name
        }
      },
      xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO DEVELOPMENT_TEAM=#{team_id}",
      export_xcargs: auth_args,
      destination: "generic/platform=iOS"
    )

    # TestFlightへの自動送信
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end


