default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    team_id = "5RBBPXKGSL"
    auth_args = "-allowProvisioningUpdates -authenticationKeyPath '#{key_path}' -authenticationKeyID '#{key_id}' -authenticationKeyIssuerID '#{issuer_id}'"

    project_path = File.expand_path("../App.xcodeproj", __dir__)
    plist_path = File.expand_path("../ExportOptions.plist", __dir__)

    # アプリのビルド・署名・IPA生成
    build_app(
      project: project_path,
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: plist_path,
      xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY='' DEVELOPMENT_TEAM=#{team_id}",
      export_xcargs: auth_args,
      destination: "generic/platform=iOS"
    )

    # TestFlightへ自動アップロード
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
